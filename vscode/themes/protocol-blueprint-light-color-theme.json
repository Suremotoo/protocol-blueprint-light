  "tokenColors": [
    {
      "name": "Blueprint annotations",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#53647D",
        "fontStyle": ""
      }
    },
    {
      "name": "Protocol keywords",
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#08754B",
        "fontStyle": ""
      }
    },
    {
      "name": "Payload strings",
      "scope": [
        "string",
        "string.quoted",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#946400",
        "fontStyle": ""
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#91501D",
        "fontStyle": ""
      }
    },
    {
      "name": "Types and interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#185B95",
        "fontStyle": ""
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#6842AD",
        "fontStyle": ""
      }
    },
    {
      "name": "Identifiers",
      "scope": [
        "variable",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#253247",
        "fontStyle": ""
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#334C70",
        "fontStyle": ""
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#086574",
        "fontStyle": ""
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#0032A0",
        "fontStyle": ""
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#086574",
        "fontStyle": ""
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#53647D",
        "fontStyle": ""
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#3D4F6A",
        "fontStyle": ""
      }
    },
    {
      "name": "Escapes",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#086574",
        "fontStyle": ""
      }
    },
    {
      "name": "Heading",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#0032A0",
        "fontStyle": ""
      }
    },
    {
      "name": "Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#0B2B86",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#0B2B86",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#0032A0",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#0C8058",
        "fontStyle": ""
      }
    },
    {
      "name": "Deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#C53046",
        "fontStyle": ""
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#C53046",
        "fontStyle": ""
      }
    },
    {
      "name": "Access and storage modifiers",
      "scope": [
        "storage.modifier",
        "keyword.other.import",
        "keyword.other.package",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.as"
      ],
      "settings": {
        "foreground": "#28558B",
        "fontStyle": ""
      }
    },
    {
      "name": "Type and function declaration words",
      "scope": [
        "storage.type.class",
        "storage.type.interface",
        "storage.type.enum",
        "storage.type.function",
        "storage.type.type",
        "storage.type.namespace",
        "storage.type.internaldeclaration",
        "storage.modifier.class.java",
        "storage.modifier.interface.java",
        "storage.modifier.enum.java",
        "storage.modifier.record.java"
      ],
      "settings": {
        "foreground": "#08754B",
        "fontStyle": ""
      }
    },
    {
      "name": "Primitive and return types",
      "scope": [
        "storage.type.primitive",
        "storage.type.primitive.array",
        "storage.type.numeric",
        "support.type.primitive"
      ],
      "settings": {
        "foreground": "#6842AD",
        "fontStyle": ""
      }
    },
    {
      "name": "Java generic arguments",
      "scope": [
        "storage.type.generic.java"
      ],
      "settings": {
        "foreground": "#08754B",
        "fontStyle": ""
      }
    },
    {
      "name": "Java generic brackets",
      "scope": [
        "punctuation.bracket.angle.java"
      ],
      "settings": {
        "foreground": "#65718A",
        "fontStyle": ""
      }
    },
    {
      "name": "Java declaration words in native declaration context",
      "scope": [
        "meta.class.identifier.java storage.modifier.java",
        "meta.record.identifier.java storage.modifier.java"
      ],
      "settings": {
        "foreground": "#08754B",
        "fontStyle": ""
      }
    },
    {
      "name": "Java container and nominal types",
      "scope": [
        "storage.type.java",
        "storage.type.object.array.java"
      ],
      "settings": {
        "foreground": "#185B95",
        "fontStyle": ""
      }
    },
    {
      "name": "Java access and import keywords",
      "scope": [
        "storage.modifier.java",
        "keyword.other.import.java",
        "keyword.other.package.java"
      ],
      "settings": {
        "foreground": "#946400",
        "fontStyle": ""
      }
    },
    {
      "name": "Java primitive return types",
      "scope": [
        "storage.type.primitive.java",
        "storage.type.primitive.array.java"
      ],
      "settings": {
        "foreground": "#185B95",
        "fontStyle": ""
      }
    },
    {
      "name": "Java package and import paths",
      "scope": [
        "storage.modifier.import.java",
        "storage.modifier.package.java"
      ],
      "settings": {
        "foreground": "#334C70",
        "fontStyle": ""
      }
    },
    {
      "name": "Java modifier chain green",
      "scope": [
        "storage.modifier.protocol.chain.green.java"
      ],
      "settings": {
        "foreground": "#08754B",
        "fontStyle": ""
      }
    },
    {
      "name": "Java modifier chain violet",
      "scope": [
        "storage.modifier.protocol.chain.violet.java"
      ],
      "settings": {
        "foreground": "#6842AD",
        "fontStyle": ""
      }
    },
    {
      "name": "Java modifier chain amber",
      "scope": [
        "storage.modifier.protocol.chain.amber.java"
      ],
      "settings": {
        "foreground": "#946400",
        "fontStyle": ""
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#185B95",
    "type": "#185B95",
    "class": "#185B95",
    "interface": "#185B95",
    "enum": "#185B95",
    "typeParameter": "#08754B",
    "function": "#6842AD",
    "method": "#6842AD",
    "variable": "#253247",
    "parameter": "#334C70",
    "property": "#086574",
    "enumMember": "#91501D",
    "variable.readonly": "#91501D",
    "string": "#946400",
    "number": "#91501D",
    "comment": "#53647D",
    "decorator": "#086574",
    "operator": "#3D4F6A",
    "function.declaration": {
      "foreground": "#6842AD",
      "bold": false
    },
    "method.declaration": {
      "foreground": "#6842AD",
      "bold": false
    },
    "modifier": "#28558B",
    "*.typeArgument:java": "#08754B",
    "parameter:java": "#334C70",
    "modifier:java": "#946400",
    "namespace:java": "#334C70"
  }
}
